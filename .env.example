[TEMPLATE]
# Supabase Configuration
# Get these from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# football-data.org API key (https://www.football-data.org/client/register)
# ⚠️  NEXT_PUBLIC_* queda INLINEADA en el bundle público: usarla solo en desarrollo
# local. Las llamadas en vivo a football-data.org solo se hacen en localhost, y el
# workflow de deploy NO inyecta esta variable: el sitio publicado no la contiene.
NEXT_PUBLIC_FOOTBALL_DATA_KEY=your-football-data-key-here
# Same key, server-side name for the node scripts (validate-fixtures, sync-official-fixtures).
# Esta es la que debe rotarse si la key se filtra.
FOOTBALL_DATA_KEY=your-football-data-key-here
# Supabase service role key — SECRET, only used by the cron (GitHub Actions secret).
# Do NOT put it in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
